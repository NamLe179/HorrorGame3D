  m_Name: 
  m_EditorClassIdentifier: 
  textName: {fileID: 6613828121428088668}
  textScript: {fileID: 7701436211445909426}
  dialogueLines:
  - characterName: Aren Mortwell
    dialogText: "Tuy\u1EC7t v\u1EDDi, c\xF3 v\u1EBB c\xE1i m\xE1y \u0111\xE3 b\u1ECB
      v\xF4 hi\u1EC7u h\xF3a. Gi\u1EDD ta ch\u1EC9 vi\u1EC7c g\u1ECDi c\u1EA3nh s\xE1t
      th\xF4i"
    dialogVoice: {fileID: 8300000, guid: 17be443fa3dc8f24c89161e1986d3a74, type: 3}
  - characterName: Aren Mortwell
    dialogText: "Ch\u1EBFt ti\u1EC7t, t\u1EA1i sao l\u1EA1i h\u1EBFt pin \u0111\xFAng
      l\xFAc n\xE0y c\u01A1 ch\u1EE9. "
    dialogVoice: {fileID: 8300000, guid: 6046fc667a9b09e49adc02722cbd0e70, type: 3}
  isActive: 1
  isFinished: 0

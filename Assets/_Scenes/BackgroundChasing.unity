  m_Name: 
  m_EditorClassIdentifier: 
  textName: {fileID: 1603476989}
  textScript: {fileID: 1603476988}
  dialogueLines:
  - characterName: "Ng\u01B0\u1EDDi ch\u01A1i"
    dialogText: "C\xE1i m\xF9i g\xEC n\u1ED3ng th\u1EBF n\xE0y. M\xF9i h\u0103ng
      nh\u01B0 g\u1EA7n ph\xF2ng x\xE1c c\u1EE7a b\u1EC7nh vi\u1EC7n th\u1EBF nh\u1EC9?
      V\xE0 c\xE1i g\xEC ch\u1EE9a trong c\xE1i l\u1ECD n\xE0y th\u1EBF n\xE0y. \u0110\u1EEBng
      n\xF3i l\xE0 ... M\xECnh c\u1EA7n ph\u1EA3i b\xE1o c\u1EA3nh s\xE1t th\xF4i."
    dialogVoice: {fileID: 8300000, guid: 63804a9e6a016e049a1b62f019d223ae, type: 3}
  - characterName: "Ng\u01B0\u1EDDi ch\u01A1i"
    dialogText: ..............
    dialogVoice: {fileID: 8300000, guid: c695a7e477b332940bc24eedc06f8e40, type: 3}
  - characterName: "Ng\u01B0\u1EDDi ch\u01A1i"
    dialogText: "Ch\u1EBFt ti\u1EC7t, t\u1EA1i sao \u1EDF \u0111\xE2y l\u1EA1i kh\xF4ng
      c\xF3 s\xF3ng. M\xECnh c\u1EA7n ph\u1EA3i tr\u1ED1n ra kh\u1ECFi \u0111\xE2y
      tr\u01B0\u1EDBc v\u1EADy."
    dialogVoice: {fileID: 8300000, guid: c8cd40aa7fd08c44280ab8a7bd7dfbdd, type: 3}
  isActive: 1
  isFinished: 0
  textSpeed: 0.05
  isPaused: 0

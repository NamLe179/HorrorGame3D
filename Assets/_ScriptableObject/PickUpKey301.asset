  dialogueLines:
  - characterName: Aren Mortwell
    dialogText: "1 chi\u1EBFc ch\xECa kh\xF3a? N\xF3 ghi l\xE0 ph\xF2ng 301. H\xECnh
      nh\u01B0 l\xE0 ph\xF2ng c\u1EE7a c\xF4 g\xE1i \u0111\u01B0\u1EE3c \u0111\u1EC1
      c\u1EADp l\xFAc n\xE3y. "
    dialogVoice: {fileID: 8300000, guid: 1a5781f912d10194aaca1f74b0addc66, type: 3}
  - characterName: Aren Mortwell
    dialogText: "T\u1EA1i sao n\xF3 l\u1EA1i r\u01A1i \u1EDF \u0111\xE2y, h\xECnh
      nh\u01B0 ch\u1EE7 nh\xE0 \u0111i ra ngo\xE0i r\u1ED3i, m\xECnh c\xF3 n\xEAn
      v\xE0o ph\xF2ng xem th\u1EED kh\xF4ng nh\u1EC9? Th\u1EADt l\xE0 t\xF2 m\xF2."
    dialogVoice: {fileID: 8300000, guid: 17a9475119f94d2489f6cae38b17fbc3, type: 3}

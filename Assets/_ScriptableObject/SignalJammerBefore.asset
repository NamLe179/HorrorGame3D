  dialogueLines:
  - characterName: Aren Mortwell
    dialogText: "C\xE1i n\xE0y l\xE0 g\xEC v\u1EADy? M\xE1y ph\xE1 s\xF3ng sao? Ch\u1EB3ng
      tr\xE1ch l\xFAc n\xE3y m\xECnh kh\xF4ng th\u1EC3 g\u1ECDi c\u1EA3nh s\xE1t.
      M\xECnh c\u1EA7n ph\u1EA3i ph\xE1 n\xF3."
    dialogVoice: {fileID: 8300000, guid: 257c186c8e543eb4dbafa85fd25a01ac, type: 3}
  - characterName: Aren Mortwell
    dialogText: "Sao nh\u1EA5n n\xFAt t\u1EAFt m\xE0 kh\xF4ng \u0111\u01B0\u1EE3c
      nh\u1EC9?. .... \xC0 d\xE2y n\u1ED1i \u0111\xE3 b\u1ECB c\u1EAFt \u0111\u1EE9t
      r\u1ED3i, m\xECnh c\u1EA7n ph\u1EA3i n\u1ED1i n\xF3 l\u1EA1i."
    dialogVoice: {fileID: 8300000, guid: e3141655309010f498871052d29d7297, type: 3}

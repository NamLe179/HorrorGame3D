  dialogueLines:
  - characterName: Aren Mortwell
    dialogText: "H\u1ECD n\xF3i sao nghe r\u1EE3n ng\u01B0\u1EDDi th\u1EBF nh\u1EC9.
      M\xECnh n\xEAn c\u1EA9n th\u1EADn 1 ch\xFAt th\xEC h\u01A1n."
    dialogVoice: {fileID: 8300000, guid: 88631b936721b584c96b682702c95834, type: 3}
  - characterName: Aren Mortwell
    dialogText: "Khoan \u0111\xE3, 301 \xE0 ? \u0110\xF3 ch\xEDnh l\xE0 ph\xF2ng
      \u0111\u1ED1i di\u1EC7n ph\xF2ng m\xECnh m\xE0."
    dialogVoice: {fileID: 8300000, guid: b84cab5466916744e9687dbe2f4bcdae, type: 3}
